{
	email {$CADDY_ACME_EMAIL}
}

{$PUBLIC_HOST} {
	encode zstd gzip

	handle /api/session/* {
		reverse_proxy frontend:3000
	}

	handle /api/* {
		reverse_proxy backend:8080
	}

	handle /ws/* {
		reverse_proxy backend:8080
	}

	handle /swagger-ui* {
		reverse_proxy backend:8080
	}

	handle /v3/api-docs* {
		reverse_proxy backend:8080
	}

	handle {
		reverse_proxy frontend:3000
	}
}
